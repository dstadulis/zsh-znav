#autoload
# _znav_precmd_once — One-Shot Post-.zshrc Alias & Command Reservation Guard
#
# Because plugin managers (such as Oh My Zsh) source plugins before personal
# aliases and functions are defined later in ~/.zshrc, _znav_precmd_once runs
# once before the first interactive prompt, immediately unregisters itself
# (zero overhead thereafter), and rebuilds projections if any shortcode in
# _ZNAV_CODE2DIR is now shadowed in $aliases/$functions/$commands/$builtins/$reswords
# or manually overridden in $nameddirs.

emulate -L zsh
setopt extended_glob warn_create_global typeset_silent no_short_loops

add-zsh-hook -d precmd _znav_precmd_once

integer _po_avoid=1
[[ -z ${ZNAV_AVOID_COMMANDS:-} || ${ZNAV_AVOID_COMMANDS:-} == [+-]#0## ]] && _po_avoid=0

local _code
for _code in "${(@k)_ZNAV_CODE2DIR}"; do
  if (( _po_avoid )) && (( $+aliases[$_code] || $+functions[$_code] || $+commands[$_code] || $+builtins[$_code] || ${reswords[(Ie)$_code]} )); then
    _znav_rebuild_projections
    break
  fi
  if (( $+nameddirs[$_code] && $+_ZNAV_OWNED_NAMEDDIRS[$_code] )) && [[ ${nameddirs[$_code]} != ${_ZNAV_OWNED_NAMEDDIRS[$_code]} ]]; then
    _znav_rebuild_projections
    break
  fi
done

_znav_update_pwd_code
_znav_p10k_setup
return 0
